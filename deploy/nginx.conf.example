# Replace the domain and certificate paths after configuring DNS and a TLS certificate.
server {
    listen 80;
    server_name your-domain.example;
    return 301 https://your-domain.example$request_uri;
}
server {
    listen 443 ssl;
    server_name your-domain.example;
    ssl_certificate /etc/letsencrypt/live/your-domain.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-domain.example/privkey.pem;
    client_max_body_size 32k;
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        # Replace client-supplied forwarding headers with the actual trusted values.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host "";
        proxy_read_timeout 35s;
    }
}
