# Copy to .env.production on the server. Do not commit real secrets.
DJANGO_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=your-domain.example
SITE_ORIGIN=https://your-domain.example
# Only behind the reverse proxy in deploy/nginx.conf.example.
DJANGO_TRUST_PROXY=true
MAK_DATA_DIR=/var/lib/mak
ADMIN_TOKEN=
RESEND_API_KEY=
NOTIFICATION_FROM=
NOTIFICATION_TO=khaledkotb611@icloud.com
